{
  "name": "conviction-only-v3",
  "version": 1,
  "description": "Trades only where the view disagrees with the book by a wide margin. v3: same conviction bar, tighter spread (4c).",
  "side": "yes",
  "universe": {
    "series": [
      "*"
    ],
    "min_volume": 50
  },
  "entry": {
    "all": [
      {
        "signal": "edge",
        "op": "gt",
        "value": 0.15
      },
      {
        "signal": "model_prob",
        "op": "between",
        "value": [
          0.25,
          0.85
        ]
      },
      {
        "signal": "spread",
        "op": "lt",
        "value": 4
      }
    ]
  },
  "sizing": {
    "method": "kelly",
    "fraction": 0.3,
    "max_bet_dollars": 12.0,
    "max_concurrent_positions": 10
  },
  "exit": {
    "any": [
      {
        "signal": "unrealized_pnl_pct",
        "op": "lt",
        "value": -0.6
      },
      {
        "signal": "hold_to_settlement",
        "op": "eq",
        "value": true
      }
    ]
  },
  "caps": {
    "daily_spend_dollars": 60.0,
    "per_market_dollars": 12.0,
    "total_exposure_dollars": 300.0
  }
}
