{
  "name": "edge-taker",
  "version": 1,
  "description": "Buy when the PM's own view says the market is underpricing this leg. The generic edge-taker: whichever view the PM holds, this agent acts on its disagreement with the book.",
  "side": "yes",
  "universe": {"series": ["*"], "min_volume": 20},
  "entry": {"all": [
    {"signal": "edge",   "op": "gt", "value": 0.06},
    {"signal": "price",  "op": "between", "value": [0.10, 0.90]},
    {"signal": "spread", "op": "lt", "value": 8}
  ]},
  "sizing": {"method": "kelly", "fraction": 0.20, "max_bet_dollars": 8.0,
             "max_concurrent_positions": 25},
  "exit": {"any": [
    {"signal": "edge", "op": "lt", "value": -0.02},
    {"signal": "unrealized_pnl_pct", "op": "lt", "value": -0.50},
    {"signal": "hold_to_settlement", "op": "eq", "value": true}
  ]},
  "caps": {"daily_spend_dollars": 60.0, "per_market_dollars": 8.0,
           "total_exposure_dollars": 300.0}
}
