# Copy this file to `.env` and fill in your own keys. `.env` is gitignored.
# The code loads these via group/env_portable.py (process env → .env → ~/.zshenv).

# ── Kalshi API ── https://kalshi.com → Profile → API Keys → "Create API Key"
# You receive a Key ID (a UUID) and download an RSA private key file (.pem).
KALSHI_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_FILE=./kalshi_private_key.pem

# ── Anthropic API ── https://console.anthropic.com → API Keys
# Powers the LLM source inside the Brain (the "winner" market pricing).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── (optional) Bearer-token fallback instead of an RSA key pair ──
# KALSHI_API_KEY=
