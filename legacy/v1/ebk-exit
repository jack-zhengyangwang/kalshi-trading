#!/usr/bin/env python3
"""
ebk-exit — one-command in-play exit monitor

Run once per bet. Monitors the market and sells automatically based on price triggers.
Defaults to background mode — close the terminal and it keeps running.

Usage:
    ebk-exit MARKET START_TIME [OPTIONS]

Arguments:
    MARKET       Kalshi ticker (KXWCGAME-...) or Polymarket slug
    START_TIME   ISO 8601 UTC kick-off (e.g. 2026-06-12T00:00:00Z)

Options:
    --execute       Live mode — actually submit sell orders (default: dry run)
    --fg            Run in foreground instead of background
    --sell-high N   Sell 65%% when price rises above N (default: 0.72)
    --sell-all-hi N Sell 100%% when price rises above N (default: 0.90)
    --sell-panic N  Sell 100%% when price drops below N (default: 0.18)
    --exchange      kalshi|polymarket  (auto-detected from ticker prefix)
    --wallet ADDR   Polymarket wallet address (polymarket only)

Environment:
    KALSHI_KEY_ID   Your Kalshi RSA key ID  (add to ~/.zshrc)
    WALLET_KEY      Polymarket private key   (add to ~/.zshrc)

Examples:
    ebk-exit KXWCGAME-26JUN11KORCZE-KOR 2026-06-12T00:00:00Z
    ebk-exit KXWCGAME-26JUN11KORCZE-KOR 2026-06-12T00:00:00Z --execute
    ebk-exit fifwc-kr-cze-2026-06-11-kr 2026-06-12T00:00:00Z --wallet 0xABC --execute
"""

import argparse, os, subprocess, sys
from datetime import datetime

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
MONITOR    = os.path.join(SCRIPT_DIR, "scripts", "inplay_exit.py")
LOG_DIR    = os.path.join(SCRIPT_DIR, "logs")


def detect_exchange(market):
    """Kalshi tickers start with KX; everything else is treated as Polymarket."""
    return "kalshi" if market.upper().startswith("KX") else "polymarket"


def main():
    p = argparse.ArgumentParser(
        prog="ebk-exit",
        description="One-command in-play exit monitor. Run once per bet.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__.split("Examples:")[1].strip()
    )

    p.add_argument("market",      help="Kalshi ticker or Polymarket slug")
    p.add_argument("start_time",  help="ISO 8601 UTC kick-off time")
    p.add_argument("--exchange",    default=None, choices=["kalshi", "polymarket"],
                   help="Override exchange auto-detection")
    p.add_argument("--wallet",      default=None, help="Polymarket wallet address")
    p.add_argument("--sell-high",   type=float, default=0.72)
    p.add_argument("--sell-all-hi", type=float, default=0.90)
    p.add_argument("--sell-panic",  type=float, default=0.18)
    p.add_argument("--execute",     action="store_true", help="Submit real orders")
    p.add_argument("--fg",          action="store_true", help="Run in foreground")

    args = p.parse_args()

    exchange = args.exchange or detect_exchange(args.market)

    # Auth check before launching
    if args.execute:
        if exchange == "kalshi" and not os.environ.get("KALSHI_KEY_ID"):
            print("ERROR: KALSHI_KEY_ID not set.")
            print("  Add to ~/.zshrc:  export KALSHI_KEY_ID=<your-key-id>")
            print("  Then:             source ~/.zshrc")
            sys.exit(1)
        if exchange == "polymarket" and not os.environ.get("WALLET_KEY"):
            print("ERROR: WALLET_KEY not set.")
            print("  Add to ~/.zshrc:  export WALLET_KEY=0x<private-key>")
            sys.exit(1)

    cmd = [
        sys.executable, MONITOR,
        "--exchange",    exchange,
        "--market",      args.market,
        "--match-start", args.start_time,
        "--sell-high",   str(args.sell_high),
        "--sell-all-hi", str(args.sell_all_hi),
        "--sell-panic",  str(args.sell_panic),
    ]
    if exchange == "polymarket" and args.wallet:
        cmd += ["--wallet", args.wallet]
    if args.execute:
        cmd.append("--execute")

    mode = "*** LIVE ***" if args.execute else "dry run"

    if args.fg:
        print(f"  [{exchange.upper()}] {args.market}  kick-off {args.start_time}  {mode}")
        print(f"  Triggers: >{args.sell_high} partial | >{args.sell_all_hi} full | <{args.sell_panic} panic\n")
        os.execv(sys.executable, cmd)

    # Background launch — detached from terminal session
    os.makedirs(LOG_DIR, exist_ok=True)
    ts       = datetime.now().strftime("%Y%m%d_%H%M%S")
    slug     = args.market.replace("/", "-")[:30]
    log_file = os.path.join(LOG_DIR, f"{slug}_{ts}.log")

    with open(log_file, "w") as lf:
        proc = subprocess.Popen(
            cmd,
            stdout=lf,
            stderr=lf,
            start_new_session=True,  # detach — survives terminal close
            env=os.environ.copy(),
        )

    print()
    print(f"  Exchange:   {exchange.upper()}")
    print(f"  Market:     {args.market}")
    print(f"  Kick-off:   {args.start_time}")
    print(f"  Mode:       {mode}")
    print(f"  Triggers:   >{args.sell_high} partial sell | >{args.sell_all_hi} full sell | <{args.sell_panic} panic")
    print()
    print(f"  PID {proc.pid} running in background — safe to close this terminal.")
    print()
    print(f"  Watch logs:   tail -f {log_file}")
    print(f"  Stop early:   kill {proc.pid}")
    print()


if __name__ == "__main__":
    main()
